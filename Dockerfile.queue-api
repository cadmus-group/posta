FROM golang:1.25.3-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/queue-api ./cmd/queue-api

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/queue-api /queue-api
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/queue-api"]
