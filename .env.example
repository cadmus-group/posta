# Development-only example; do not reuse these settings on a public host.
# Queue API
HTTP_ADDR=:8081
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_HEADER_TIMEOUT_MS=5000

# Redis: local development has no password. Configure Redis authentication separately
# for production; the development Redis service does not enable auth automatically.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_PING_TIMEOUT_MS=1500

# Empty disables API token authentication. REQUIRED or use stronger ingress auth in production.
ENQUEUE_AUTH_TOKEN=

# Development demonstration module only. Handler logs payloads; do not send secrets.
EDGE_MODULES=generic
EDGE_ALLOWED_TASK_TYPES=
EDGE_ALLOWED_QUEUES=default,critical

# Queues and worker
QUEUE_DEFAULT=default
QUEUE_CRITICAL=critical
QUEUE_ALLOWLIST=default,critical
QUEUE_WEIGHT_DEFAULT=5
QUEUE_WEIGHT_CRITICAL=10
ASYNQ_CONCURRENCY=20

