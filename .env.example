# HTTP
HTTP_ADDR=:8081
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_HEADER_TIMEOUT_MS=5000

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_PING_TIMEOUT_MS=1500

# Auth for /v1/enqueue (optional for local dev, required for prod)
ENQUEUE_AUTH_TOKEN=

# Queues
QUEUE_DEFAULT=default
QUEUE_CRITICAL=critical
QUEUE_ALLOWLIST=default,critical
QUEUE_WEIGHT_DEFAULT=5
QUEUE_WEIGHT_CRITICAL=10

# Worker
ASYNQ_CONCURRENCY=20
