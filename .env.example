# Base Redis connection (override in production)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_PING_TIMEOUT_MS=1500

# queue-api HTTP listener
HTTP_ADDR=:8081
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_HEADER_TIMEOUT_MS=5000

# Auth (set in prod)
ENQUEUE_AUTH_TOKEN=
QUEUE_API_AUTH_TOKEN=

# Queues and modules
QUEUE_ALLOWLIST=default,critical
EDGE_ALLOWED_QUEUES=default,critical
EDGE_ALLOWED_TASK_TYPES=
EDGE_MODULES=demo

# Worker
ASYNQ_CONCURRENCY=20
QUEUE_DEFAULT=default
QUEUE_CRITICAL=critical
QUEUE_WEIGHT_DEFAULT=5
QUEUE_WEIGHT_CRITICAL=10

# Scheduler
SCHEDULER_ENABLE_DEMO_JOBS=false

# Observability / tracing (disabled by default)
EDGE_OTEL_ENABLE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=posta

# TLS / mTLS dev certs (used by scripts/gen-certs.sh and compose overlay)
TLS_DOMAIN=localhost
TLS_CA_CERT=./certs/ca.crt
TLS_CA_KEY=./certs/ca.key
TLS_SERVER_CERT=./certs/server.crt
TLS_SERVER_KEY=./certs/server.key
TLS_CLIENT_CERT=./certs/client.crt
TLS_CLIENT_KEY=./certs/client.key